<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Repairing damaged mechanoids (vanilla WorkGiverDef RepairMech). -->
  <WorkTypeDef>
    <defName>MechRepair</defName>
    <labelShort>mech repair</labelShort>
    <pawnLabel>Mech repairer</pawnLabel>
    <gerundLabel>repairing mechs</gerundLabel>
    <description>Repair damaged mechanoids. Only mechanitors can do this work.</description>
    <verb>Repair</verb>
    <naturalPriority>468</naturalPriority>
    <alwaysStartActive>true</alwaysStartActive>
    <relevantSkills>
      <li>Crafting</li>
    </relevantSkills>
    <workTags>
      <li>Crafting</li>
      <li>ManualSkilled</li>
      <li>Commoner</li>
      <li>AllWork</li>
    </workTags>
  </WorkTypeDef>

  <!-- Gestating and resurrecting mechanoids at mech gestators (vanilla WorkGiverDef DoBillsMechGestator). -->
  <WorkTypeDef>
    <defName>MechBirthing</defName>
    <labelShort>mech birth</labelShort>
    <pawnLabel>Mech birther</pawnLabel>
    <gerundLabel>birthing mechs</gerundLabel>
    <description>Gestate new mechanoids and resurrect dead ones at mech gestators. Only mechanitors can do this work.</description>
    <verb>Birth</verb>
    <naturalPriority>466</naturalPriority>
    <alwaysStartActive>true</alwaysStartActive>
    <relevantSkills>
      <li>Crafting</li>
    </relevantSkills>
    <workTags>
      <li>Crafting</li>
      <li>ManualSkilled</li>
      <li>Commoner</li>
      <li>AllWork</li>
    </workTags>
  </WorkTypeDef>

  <!-- Encoding subcores at the subcore encoder (vanilla WorkGiverDef DoBillsSubcoreEncoder). -->
  <WorkTypeDef>
    <defName>SubcoreEncoding</defName>
    <labelShort>subcores</labelShort>
    <pawnLabel>Subcore encoder</pawnLabel>
    <gerundLabel>encoding subcores</gerundLabel>
    <description>Encode subcores at the subcore encoder. Only mechanitors can do this work.</description>
    <verb>Encode</verb>
    <naturalPriority>464</naturalPriority>
    <alwaysStartActive>true</alwaysStartActive>
    <relevantSkills>
      <li>Crafting</li>
    </relevantSkills>
    <workTags>
      <li>Crafting</li>
      <li>ManualSkilled</li>
      <li>Commoner</li>
      <li>AllWork</li>
    </workTags>
  </WorkTypeDef>

</Defs>
