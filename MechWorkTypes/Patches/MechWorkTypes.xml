<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Mech repair: move off Smithing. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/WorkGiverDef[defName="RepairMech"]/workType</xpath>
    <value>
      <workType>MechRepair</workType>
    </value>
  </Operation>

  <!-- Mech gestation and resurrection bills at mech gestators: move off Smithing. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/WorkGiverDef[defName="DoBillsMechGestator"]/workType</xpath>
    <value>
      <workType>MechBirthing</workType>
    </value>
  </Operation>

</Patch>